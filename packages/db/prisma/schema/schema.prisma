generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  user
  admin
}

model User {
  id       String   @id @default(uuid())
  username String   @unique
  password String
  role     UserRole @default(user)

  orders Order[]
  fills  Fill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id     String  @id @default(uuid())
  slug   String
  symbol String
  image  String?

  orders Order[]
  fills  Fill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderType {
  LONG
  SHORT
}

enum MarketType {
  SOL
  ETH
  BTC
}

enum OrderStatus {
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  OPEN
}

enum SideType {
  Market
  Limit
}

model Order {
  id String @id @default(uuid())

  marketType MarketType
  type       OrderType
  status     OrderStatus
  side       SideType

  qty      BigInt
  price    BigInt?
  margin   BigInt
  slippage Int?
  fillQty  Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketId String
  market   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  makerFill Fill[] @relation("makerOrderId")
  takerFill Fill[] @relation("takerOrderId")
  fills     Fill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fill {
  id     String @id @default(uuid())
  fillId String @unique
  qty    BigInt
  price  BigInt

  makerId    String
  makerOrder Order  @relation("makerOrderId", fields: [makerId], references: [id], onDelete: Cascade)
  takerId    String
  takerOrder Order  @relation("takerOrderId", fields: [takerId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  marketId String
  marker   Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
