generator client {
  provider     = "prisma-client"
  output       = "../generated"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Market {
  id     String @id @default(uuid())
  slug   String
  symbok String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderType {
  LONG
  SHORT
}

enum MarketType {
  SOL
  ETH
  BTC
}

enum OrderStatus {
  FILLED
  PARTIALLY_FILLED
  CANCELLED
  OPEN
}

model Order {
  id String @id @default(uuid())

  market MarketType
  type   OrderType
  status OrderStatus

  qty      Int
  price    Int
  margin   Int
  sleepage Int?
  fillQty  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Fill {
  id      String @id @default(uuid())
  stockId String
  qty     Int
  price   Int
}
